{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.md",
      "!src-tauri",
      "!**/package-lock.json",
      "!playwright-report",
      "!test-results"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noExplicitAny": "warn" },
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
