{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window. The app's own commands (src-tauri/src) need no entry here; plugin APIs called from TypeScript do.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "dialog:allow-ask",
    "dialog:allow-message",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }] },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }, { "path": "$APPLOG" }, { "path": "$APPLOG/**" }]
    },
    "log:default",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "updater:default",
    "process:allow-restart"
  ]
}
