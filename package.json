{
  "name": "tauri-template",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop app template: Tauri 2 + TypeScript + Vite, no framework. Built to be extended by AI agents.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fmt:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:js": "npm run typecheck && npm run lint && npm run i18n && npm run build && npm run test && npm run e2e",
    "check:rs": "npm run fmt:rs && npm run lint:rs && npm run test:rs",
    "check": "npm run check:js && npm run check:rs",
    "icons": "tauri icon src-tauri/icons/icon.svg",
    "init-app": "node scripts/init-app.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-log": "^2.10.2",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.11",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
